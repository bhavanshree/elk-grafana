spring.application.name=testbase
server.port=8086
#spring.profiles.active=dev

#logging
logging.level.root=DEBUG

gateway.url=http://gateway:8181/

acknowledge.url=http://acknowledge:8087/
testbase.url=http://testbase:8086/
facility.url=http://facility:8085/
order.url=http://order:8084/
patient.url=http://patient:8083/
registration.url=http://registration:8082/
userprofile.url=http://userprofile:8081/
result.url=http://result:8088/

# PostgresSQL Database Configuration
#spring.datasource.postgresql.url=jdbc:postgresql://localhost:5432/mydatabase
#spring.datasource.postgresql.username=postgres
#spring.datasource.postgresql.password=password
#spring.datasource.postgresql.driver-class-name=org.postgresql.Driver

# Oracle database connection configuration
# JDBC URL
spring.datasource.url=jdbc:oracle:thin:@//130.78.204.139:1521/DHEMDB

# Username and password for the remote server
spring.datasource.username=appluser
spring.datasource.password=appluser

# JDBC Driver Class
spring.datasource.driver-class-name=oracle.jdbc.OracleDriver

# Hibernate Dialect for Oracle 19c
spring.jpa.database-platform=org.hibernate.dialect.OracleDialect

# Additional JPA Properties
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=true

#hikariCP
spring.datasource.hikari.connectionTimeout=200000
spring.datasource.hikari.idleTimeout=120000
spring.datasource.hikari.maxLifetime=1800000
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=10
spring.datasource.hikari.data-source-properties.oracle.jdbc.defaultConnectionValidation=LOCAL

logging.level.com.zaxxer.hikari.HikariConfig=DEBUG
logging.level.com.zaxxer.hikari=DEBUG

management.endpoint.metrics.enabled=true
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always

openapi.service.title=testbase
openapi.service.version=1.0.0
openapi.service.url=http://130.78.204.112:7791/api/gateway/swagger

springdoc.api-docs.path=/testbase/v3/api-docs
springdoc.swagger-ui.path=/testbase/swagger-ui.html